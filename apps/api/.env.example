DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
TRUSTED_PROXY_HOPS=1

# Account used by the "Try the demo" button. Created by `pnpm db:seed`.
DEMO_USER_EMAIL=demo@jobtracker.dev

# Optional: enables the AI features. Without it the AI endpoints answer 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
